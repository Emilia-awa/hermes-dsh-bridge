# dsh ecosystem publishes @deepseek-ai/* packages as fast-moving prereleases
# whose peer ranges are frequently inconsistent between each other (e.g.
# dsh-agent@0.1.0-rc.6 peers dsh-llm@^0.1.0-rc.6 while older manifests declare
# ^0.0.1-rc.1). The plugin always runs *inside* a Harness install where these
# modules resolve from Harness's global tree (see README dual-package hazard),
# so strict peer resolution is neither meaningful nor satisfiable in CI.
legacy-peer-deps=true