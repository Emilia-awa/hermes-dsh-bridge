{
  "name": "hermes-dsh-bridge",
  "version": "0.11.1",
  "description": "Expose DeepSeek Harness agent capabilities as an MCP server, so an external MCP client (e.g. Hermes) can drive Harness to execute coding tasks. Hermes = brain, Harness = arms.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "files": [
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "docs/CHANGELOG.md",
    "docs/CONFIG.md",
    "docs/KNOWN_ISSUES.md",
    "docs/SECURITY.md",
    "docs/TOOLS.md",
    "docs/TROUBLESHOOTING.md"
  ],
  "scripts": {
    "postinstall": "node scripts/link-host-deps.mjs || echo \"[hermes-dsh-bridge] postinstall: link-host-deps 未成功（多半是找不到 Harness 全局树）—— 请手动跑 `node scripts/link-host-deps.mjs`，或看 README「dual-package hazard」一节。这不影响安装完成。\"",
    "build": "tsdown --env.DSH_BUILD_FACE host && tsc -b && node scripts/check-build-artifacts.mjs",
    "build:clean": "rm -rf lib && npm run build",
    "doctor": "node scripts/doctor.mjs",
    "test": "node tests/unit_mock_p1.mjs && node tests/unit_mock_p2.mjs && node tests/unit_mock_p3.mjs && node tests/unit_callback_p0.mjs && node tests/unit_mock_r1.mjs && node tests/unit_contract_p0.mjs && node tests/unit_r7.mjs && node tests/unit_r8.mjs && node tests/unit_r9.mjs && node tests/link_host_deps_r10.mjs",
    "test:e2e": "node scripts/e2e_r7.mjs",
    "test:mutation": "node scripts/mutation_check_r1.mjs && node scripts/mutation_check_r7.mjs && node scripts/mutation_check_r8.mjs && node scripts/mutation_check_r9.mjs",
    "contract": "node scripts/contract_probe.mjs",
    "link-deps": "node scripts/link-host-deps.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "mcp",
    "model-context-protocol",
    "cordis",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Emilia-awa/hermes-dsh-bridge.git"
  },
  "homepage": "https://github.com/Emilia-awa/hermes-dsh-bridge#readme",
  "bugs": {
    "url": "https://github.com/Emilia-awa/hermes-dsh-bridge/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-presets": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-atomic-write": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-attachment": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-brand": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-code-runtime": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-timeout": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.1.2-rc.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "~22",
    "typescript": "~5.7",
    "tsdown": "^0.12.9"
  }
}
